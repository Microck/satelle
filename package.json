{
  "name": "satelle-repository",
  "version": "0.1.43",
  "private": true,
  "workspaces": [
    "website"
  ],
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "check:npm": "node --test npm/test/npm-distribution.test.cjs npm/test/package-managers.test.cjs npm/test/release-followup.test.cjs npm/test/release-infrastructure.test.cjs npm/test/output-format-conformance.test.cjs",
    "docs:build": "npm run build --workspace website",
    "docs:dev": "npm run dev --workspace website",
    "release:check": "node npm/scripts/release.cjs check",
    "release:validate-native-archives": "node npm/scripts/release.cjs validate-native-release-archives",
    "test": "npm run check:npm",
    "test:npm": "npm run check:npm"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.15.2",
    "@toon-format/toon": "4.1.1",
    "e2e": "0.21.2",
    "sigstore": "4.1.1"
  }
}
